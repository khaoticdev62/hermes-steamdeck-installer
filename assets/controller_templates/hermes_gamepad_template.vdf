"controller_mappings"
{
	"version" "3"
	"game_title" "Hermes Agent"
	"description" "Official Hermes Agent Steam Deck Handheld Profile: Left Trackpad Radial Menu for Hermes tools, Right Trackpad Mouse, L4 Voice Push-to-Talk, R4 Virtual Keyboard."
	"creator" "khaoticdev62"

	"group"
	{
		"id" "0"
		"mode" "four_buttons"
		"bindings"
		{
			"button_A" "key_press RETURN, Enter"
			"button_B" "key_press ESCAPE, Escape"
			"button_X" "key_press TAB, Tab"
			"button_Y" "key_press SPACE, Space"
		}
	}

	"group"
	{
		"id" "1"
		"mode" "dpad"
		"bindings"
		{
			"dpad_north" "key_press UP, Up"
			"dpad_south" "key_press DOWN, Down"
			"dpad_east" "key_press RIGHT, Right"
			"dpad_west" "key_press LEFT, Left"
		}
	}

	"group"
	{
		"id" "2"
		"mode" "mouse"
		"bindings"
		{
			"click" "mouse_button LEFT, Left Click"
		}
		"settings"
		{
			"sensitivity" "120"
			"trackball" "1"
		}
	}

	"group"
	{
		"id" "3"
		"mode" "radial_menu"
		"bindings"
		{
			"menu_button_0" "key_press F1, Ask Hermes"
			"menu_button_1" "key_press F2, Fix Game (ProtonDB)"
			"menu_button_2" "key_press F3, Clean Compatdata"
			"menu_button_3" "key_press F4, Backup Saves"
			"menu_button_4" "key_press F5, Battery Status"
		}
		"settings"
		{
			"touch_menu_button_count" "5"
			"touch_menu_opacity" "85"
		}
	}

	"preset"
	{
		"id" "0"
		"name" "Hermes Handheld Default"
		"group_source_bindings"
		{
			"0" "button_diamond"
			"1" "dpad"
			"2" "right_trackpad"
			"3" "left_trackpad"
		}
		"switch_bindings"
		{
			"bindings"
			{
				"button_r_trigger" "mouse_button LEFT, Left Click"
				"button_l_trigger" "mouse_button RIGHT, Right Click"
				"button_r_grip" "key_press F12, Steam Virtual Keyboard"
				"button_l_grip" "key_press F13, Voice Push-to-Talk"
			}
		}
	}
}
